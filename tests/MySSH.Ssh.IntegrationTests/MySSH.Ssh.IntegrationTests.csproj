<Project Sdk="Microsoft.NET.Sdk">
  <!-- The name does not end in ".Tests", so set what Directory.Build.props would. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1707;CA1515;CA1861;CA2007</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="../MySSH.Ssh.Tests/TestDoubles.cs" Link="TestDoubles.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MySSH.Ssh/MySSH.Ssh.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
</Project>
