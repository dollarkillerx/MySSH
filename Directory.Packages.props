<Project>
  <!-- Central package versions. Pinned by the P0 spikes (spikes/FINDINGS.md); bump deliberately. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="UI">
    <PackageVersion Include="Avalonia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Themes.Simple" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.6" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup Label="Terminal / SSH / MCP / AI">
    <PackageVersion Include="XTerm.NET" Version="3.0.3" />
    <PackageVersion Include="SSH.NET" Version="2026.0.1" />
    <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageVersion Include="Anthropic" Version="13.8.0" />
    <PackageVersion Include="OpenAI" Version="2.15.0" />
    <PackageVersion Include="JsonSchema.Net" Version="9.7.0" />
  </ItemGroup>
  <ItemGroup Label="Storage / crypto / hosting">
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <!-- 3.x: Avalonia.Headless.XUnit 12.1.6 is built against xunit.v3 3.2 -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
