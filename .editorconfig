root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,axaml,xml,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
# Library code is not UI-thread bound; ConfigureAwait noise is not worth it in this codebase.
dotnet_diagnostic.CA2007.severity = none
# Logging perf rule is enforced via LoggerMessage where it matters, not globally.
dotnet_diagnostic.CA1848.severity = suggestion
