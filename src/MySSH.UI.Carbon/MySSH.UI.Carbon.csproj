<Project Sdk="Microsoft.NET.Sdk">
  <!-- IBM Carbon Design System v11 theme for Avalonia (design §9). Tokens / icons / fonts are generated by
       tools/gen-carbon-tokens and tools/gen-carbon-icons and committed; building never needs node. -->
  <PropertyGroup>
    <RootNamespace>MySSH.UI.Carbon</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Simple" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MySSH.UI.Carbon.Tests" />
  </ItemGroup>
</Project>
