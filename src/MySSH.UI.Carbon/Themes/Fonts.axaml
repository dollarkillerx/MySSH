<!-- IBM Plex Sans / Mono (SIL OFL 1.1, see Assets/Fonts/OFL.txt), bundled Latin/Greek/Cyrillic only.
     CJK text needs an explicit platform font chain that matches the UI language (CarbonFonts.Apply, called by the app
     on every language change); these defaults are for hosts that never call it. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="CarbonFontSans">avares://MySSH.UI.Carbon/Assets/Fonts#IBM Plex Sans, $Default</FontFamily>
  <FontFamily x:Key="CarbonFontMono">avares://MySSH.UI.Carbon/Assets/Fonts#IBM Plex Mono, Menlo, Consolas, $Default</FontFamily>
  <!-- Simple theme compatibility -->
  <StaticResource x:Key="ContentControlThemeFontFamily" ResourceKey="CarbonFontSans" />
  <x:Double x:Key="FontSizeSmall">12</x:Double>
  <x:Double x:Key="FontSizeNormal">14</x:Double>
  <x:Double x:Key="FontSizeLarge">16</x:Double>
  <Thickness x:Key="ThemeBorderThickness">1</Thickness>
  <x:Double x:Key="ThemeDisabledOpacity">0.5</x:Double>
  <x:Double x:Key="ScrollBarThickness">8</x:Double>
</ResourceDictionary>
