<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:carbon="https://myssh.app/carbon"
             xmlns:l="using:MySSH.Desktop.Localization"
             xmlns:vm="using:MySSH.Desktop.ViewModels"
             xmlns:t="using:MySSH.Terminal"
             x:Class="MySSH.Desktop.Views.TerminalSessionView"
             x:DataType="vm:TerminalSessionViewModel">
  <DockPanel>
    <!-- status bar (design §8.4): state · chain · grid size -->
    <Border DockPanel.Dock="Bottom" Height="32" Background="{DynamicResource CarbonLayer01}"
            BorderBrush="{DynamicResource CarbonBorderSubtle01}" BorderThickness="0,1,0,0">
      <DockPanel>
      <Button DockPanel.Dock="Right" Name="OpenSftpButton" Classes="ghost sm" Margin="0,0,8,0" VerticalAlignment="Center"
              carbon:ButtonAssist.Icon="folder-open" Content="{l:Tr terminal.openSftp}" ToolTip.Tip="{l:Tr terminal.openSftpTip}"
              Command="{Binding OpenSftpCommand}" />
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0" VerticalAlignment="Center">
        <Ellipse Name="StateDot" Width="8" Height="8" VerticalAlignment="Center" />
        <TextBlock Classes="label-01" Text="{Binding StateText}" VerticalAlignment="Center" />
        <TextBlock Classes="label-01 secondary" Text="·" VerticalAlignment="Center" />
        <TextBlock Classes="label-01 secondary" Text="{Binding Via}" VerticalAlignment="Center" />
        <TextBlock Classes="label-01 secondary" Text="·" VerticalAlignment="Center" />
        <TextBlock Classes="label-01 secondary" Text="{Binding GridSize}" VerticalAlignment="Center" />
        <TextBlock Name="RemoteTitle" Classes="label-01 secondary" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="480" />
      </StackPanel>
      </DockPanel>
    </Border>

    <!-- connection banner: lost / ended / failed, with reconnect -->
    <carbon:InlineNotification DockPanel.Dock="Top" Name="Banner" IsLowContrast="False" Margin="0"
                               IsVisible="{Binding ShowBanner}" Subtitle="{Binding StatusMessage}" IsCloseButtonVisible="False">
      <carbon:InlineNotification.Action>
        <Button Classes="ghost sm" Content="{l:Tr terminal.reconnect}" Command="{Binding ReconnectCommand}" />
      </carbon:InlineNotification.Action>
    </carbon:InlineNotification>

    <Panel Background="{DynamicResource CarbonBackground}">
      <t:TerminalView Name="Term" Margin="8,8,0,0">
        <t:TerminalView.ContextMenu>
          <ContextMenu Name="TermMenu">
            <MenuItem Name="MenuCopy" Header="{l:Tr common.copy}" Click="OnCopySelection" />
            <Separator />
            <MenuItem Name="MenuExplain" Header="{l:Tr ai.menu.explain}" Click="OnAskExplain" />
            <MenuItem Name="MenuAnalyze" Header="{l:Tr ai.menu.analyzeError}" Click="OnAskAnalyze" />
            <Separator />
            <MenuItem Name="MenuInline" Header="{l:Tr ai.menu.inline}" Command="{Binding OpenInlineCommand}" />
          </ContextMenu>
        </t:TerminalView.ContextMenu>
      </t:TerminalView>

      <!-- Ctrl+I / Cmd+I: describe a command, Tab inserts it on the prompt line (never runs it) -->
      <Border Name="InlineBar" IsVisible="{Binding IsInlineOpen}" VerticalAlignment="Bottom" Margin="24,0,24,16"
              Background="{DynamicResource CarbonLayer01}" BorderBrush="{DynamicResource CarbonBorderSubtle01}" BorderThickness="1"
              MaxWidth="760">
        <StackPanel Margin="12" Spacing="8">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <carbon:CarbonIcon Kind="magic-wand" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Name="InlineBox" Text="{Binding InlineRequest}" PlaceholderText="{l:Tr ai.inline.placeholder}"
                     KeyDown="OnInlineKeyDown" />
            <ProgressBar Grid.Column="2" Classes="sm" IsIndeterminate="True" Width="48" Margin="8,0,0,0" IsVisible="{Binding IsInlineBusy}" />
          </Grid>
          <Border Background="{DynamicResource CarbonField02}" Padding="8,6" IsVisible="{Binding HasInlineSuggestion}">
            <SelectableTextBlock Name="InlineSuggestionText" Classes="code-01" TextWrapping="Wrap" Text="{Binding InlineSuggestion}" />
          </Border>
          <TextBlock Classes="helper-text-01 error" TextWrapping="Wrap" Text="{Binding InlineError}"
                     IsVisible="{Binding InlineError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Classes="helper-text-01 secondary" Text="{l:Tr ai.inline.hint}" />
        </StackPanel>
      </Border>
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" IsVisible="{Binding IsConnecting}">
        <ProgressBar Classes="sm" IsIndeterminate="True" Width="240" />
        <TextBlock Classes="body-01 secondary" HorizontalAlignment="Center" Text="{Binding StatusMessage}" />
      </StackPanel>
    </Panel>
  </DockPanel>
</UserControl>
