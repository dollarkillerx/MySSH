<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MySSH.Desktop.ViewModels"
             xmlns:l="using:MySSH.Desktop.Localization"
             x:Class="MySSH.Desktop.Views.PlaceholderPage"
             x:DataType="vm:PlaceholderPageViewModel">
  <StackPanel Margin="32,24" Spacing="8">
    <TextBlock Classes="heading-04" Text="{Binding Title}" />
    <TextBlock Classes="body-01 secondary" Text="{l:Tr common.comingSoon}" />
  </StackPanel>
</UserControl>
