<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>MySSH</AssemblyName>
    <RootNamespace>MySSH.Desktop</RootNamespace>
    <!-- Reverse-DNS app identity (macOS CFBundleIdentifier, Linux desktop-file id, Windows AppUserModelID).
         Same value as MySSH.Core.AppIdentity.BundleId and macOS/Info.plist. Never change it after a release. -->
    <ApplicationId>cc.nyxnet.myssh</ApplicationId>
    <ApplicationTitle>MySSH</ApplicationTitle>
    <ApplicationIcon>../../assets/icons/icon.ico</ApplicationIcon>
    <PublishAot>true</PublishAot>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <NeutralLanguage>en-US</NeutralLanguage>
    <!-- Third-party assemblies only report collapsed IL2104/IL3053; tools/aot/check-aot-warnings.sh gates the
         individual warnings against a reviewed allowlist. Our own libraries are analysed member-by-member. -->
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
    <SatelliteResourceLanguages>en-US;zh-CN;ja-JP</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MySSH.Desktop.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../MySSH.Core/MySSH.Core.csproj" />
    <ProjectReference Include="../MySSH.Storage/MySSH.Storage.csproj" />
    <ProjectReference Include="../MySSH.Ssh/MySSH.Ssh.csproj" />
    <ProjectReference Include="../MySSH.UI.Carbon/MySSH.UI.Carbon.csproj" />
    <ProjectReference Include="../MySSH.Terminal/MySSH.Terminal.csproj" />
    <ProjectReference Include="../MySSH.Tools/MySSH.Tools.csproj" />
    <ProjectReference Include="../MySSH.Mcp/MySSH.Mcp.csproj" />
    <!-- Built, not referenced: the myssh-mcp stdio bridge sits next to the app (McpClientSetup.DefaultBridgePath). -->
    <ProjectReference Include="../MySSH.McpBridge/MySSH.McpBridge.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Simple" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <!-- Dev builds: copy the bridge (JIT apphost + dll) next to MySSH so the Claude Desktop setup works with `dotnet run`. -->
  <Target Name="CopyMcpBridge" AfterTargets="Build" Condition="'$(_IsPublishing)' != 'true'">
    <MSBuild Projects="../MySSH.McpBridge/MySSH.McpBridge.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_McpBridgeTarget" />
    </MSBuild>
    <PropertyGroup>
      <_McpBridgeDir>@(_McpBridgeTarget->'%(RootDir)%(Directory)')</_McpBridgeDir>
    </PropertyGroup>
    <ItemGroup>
      <_McpBridgeFiles Include="$(_McpBridgeDir)myssh-mcp*" />
    </ItemGroup>
    <Copy SourceFiles="@(_McpBridgeFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Publish: the bridge goes next to MySSH as its own NativeAOT executable (Claude Desktop runs it; it also starts MySSH
       in the tray). The JIT leftovers of the build-only project reference are removed. -->
  <Target Name="PublishMcpBridge" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != ''">
    <Delete Files="$(PublishDir)myssh-mcp.runtimeconfig.json;$(PublishDir)myssh-mcp.deps.json;$(PublishDir)myssh-mcp.dll;$(PublishDir)myssh-mcp.pdb" />
    <MSBuild Projects="../MySSH.McpBridge/MySSH.McpBridge.csproj" Targets="Restore;Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);PublishDir=$([System.IO.Path]::GetFullPath('$(PublishDir)'));StripSymbols=$(StripSymbols)" />
  </Target>
</Project>
