<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:carbon="https://myssh.app/carbon"
        xmlns:l="using:MySSH.Desktop.Localization"
        xmlns:vm="using:MySSH.Desktop.ViewModels"
        xmlns:local="using:MySSH.Desktop"
        xmlns:v="using:MySSH.Desktop.Views"
        x:Class="MySSH.Desktop.MainWindow"
        x:DataType="vm:ShellViewModel"
        Width="1280" Height="800" MinWidth="900" MinHeight="560"
        Title="MySSH"
        Icon="avares://MySSH/Assets/icon.png"
        Background="{DynamicResource CarbonBackground}">
  <Panel>
    <DockPanel>
      <!-- UI Shell header (design §9.4): always Gray 100 -->
      <carbon:ShellHeader DockPanel.Dock="Top" ProductPrefix="MySSH" IsMenuButtonVisible="True"
                          IsMenuOpen="{Binding #Nav.IsExpanded, Mode=TwoWay}">
        <carbon:ShellHeader.GlobalActions>
          <StackPanel Orientation="Horizontal">
            <Button Name="AiToggle" Classes="header-action" carbon:ButtonAssist.Icon="chat" ToolTip.Tip="{l:Tr ai.toggle}"
                    Command="{Binding Assistant.ToggleCommand, FallbackValue={x:Null}}" IsVisible="{Binding Assistant, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Button Name="ThemeToggle" Classes="header-action" carbon:ButtonAssist.Icon="asleep" />
            <Button Name="LanguageButton" Classes="header-action" carbon:ButtonAssist.Icon="translate">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="English" Tag="en-US" Click="OnLanguageClick" />
                  <MenuItem Header="简体中文" Tag="zh-CN" Click="OnLanguageClick" />
                  <MenuItem Header="日本語" Tag="ja-JP" Click="OnLanguageClick" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </carbon:ShellHeader.GlobalActions>
      </carbon:ShellHeader>

      <carbon:SideNavRail Name="Nav" DockPanel.Dock="Left" />

      <!-- AI assistant (Ctrl+Shift+A) -->
      <v:AiAssistantPanel Name="AiPanel" DockPanel.Dock="Right" DataContext="{Binding Assistant}"
                          IsVisible="{Binding IsOpen, FallbackValue=False}" />

      <Grid RowDefinitions="Auto,*">
        <!-- inline notifications (import results, storage problems) -->
        <ItemsControl ItemsSource="{Binding Notifications}" Margin="32,16,32,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NotificationViewModel">
              <carbon:InlineNotification Kind="{Binding Kind, Converter={x:Static local:Converters.NotificationKind}}"
                                         Title="{Binding Title}" Subtitle="{Binding Message}" IsLowContrast="True"
                                         Closed="OnNotificationClosed" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- active page; typed templates keep compiled bindings (AOT) -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:HostListViewModel"><v:HostsPage /></DataTemplate>
            <!-- sessions are rendered by the persistent SessionsPage below, never recreated -->
            <DataTemplate DataType="vm:SessionsWorkspaceViewModel"><Panel /></DataTemplate>
            <DataTemplate DataType="vm:IdentitiesViewModel"><v:IdentitiesPage /></DataTemplate>
            <DataTemplate DataType="vm:KnownHostsViewModel"><v:KnownHostsPage /></DataTemplate>
            <DataTemplate DataType="vm:SettingsViewModel"><v:SettingsPage /></DataTemplate>
            <DataTemplate DataType="vm:AiMcpPageViewModel"><v:AiMcpPage /></DataTemplate>
            <DataTemplate DataType="vm:PlaceholderPageViewModel"><v:PlaceholderPage /></DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>

        <v:SessionsPage Grid.Row="1" DataContext="{Binding Sessions}" IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).IsSessionsActive}" />

        <ProgressBar Grid.Row="1" Classes="sm" IsIndeterminate="True" VerticalAlignment="Top"
                     IsVisible="{Binding IsBusy}" />
      </Grid>
    </DockPanel>

    <!-- Vault: unlock / create master password (design §5.1) -->
    <carbon:Modal Name="VaultModal" Size="Small" IsDismissible="False" SecondaryButtonText=""
                  Heading="{l:Tr vault.unlock.title}" PrimaryButtonText="{l:Tr vault.unlock.action}">
      <StackPanel Spacing="16">
        <TextBlock Classes="body-01" TextWrapping="Wrap" Text="{l:Tr vault.unlock.body}" />
        <TextBox Name="MasterPasswordBox" Classes="password" PasswordChar="●"
                 carbon:Field.Label="{l:Tr vault.unlock.password}"
                 carbon:Field.IsInvalid="{Binding VaultError, Converter={x:Static ObjectConverters.IsNotNull}}"
                 carbon:Field.InvalidText="{Binding VaultError}"
                 Text="{Binding MasterPassword}" />
      </StackPanel>
    </carbon:Modal>

    <!-- generic dialogs for IUiServices (confirm, password prompt) -->
    <carbon:Modal Name="DialogModal" Size="Small">
      <StackPanel Spacing="16">
        <TextBlock Name="DialogBody" Classes="body-01" TextWrapping="Wrap" />
        <TextBox Name="DialogText" IsVisible="False" />
        <TextBox Name="DialogPassword" Classes="password" PasswordChar="●" IsVisible="False" />
        <TextBox Name="DialogPasswordConfirm" Classes="password" PasswordChar="●" IsVisible="False" />
      </StackPanel>
    </carbon:Modal>

    <!-- host key verification (TOFU, design §5.2): Unknown = verify; Changed = danger, accept only after explicit check -->
    <carbon:Modal Name="HostKeyModal" Size="Medium" IsDismissible="False">
      <StackPanel Spacing="16">
        <TextBlock Name="HostKeyBody" Classes="body-01" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="Auto,16,*" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto">
          <TextBlock Classes="label-01 secondary" Text="{l:Tr hostKey.host}" />
          <SelectableTextBlock Grid.Column="2" Name="HostKeyHost" Classes="code-01" />
          <TextBlock Grid.Row="2" Classes="label-01 secondary" Text="{l:Tr hostKey.type}" />
          <SelectableTextBlock Grid.Row="2" Grid.Column="2" Name="HostKeyType" Classes="code-01" />
          <TextBlock Grid.Row="4" Classes="label-01 secondary" Text="{l:Tr hostKey.fingerprint}" />
          <SelectableTextBlock Grid.Row="4" Grid.Column="2" Name="HostKeyFingerprint" Classes="code-01" TextWrapping="Wrap" />
          <TextBlock Grid.Row="6" Name="HostKeyPreviousLabel" Classes="label-01 secondary" Text="{l:Tr hostKey.previous}" />
          <SelectableTextBlock Grid.Row="6" Grid.Column="2" Name="HostKeyPrevious" Classes="code-01 error" TextWrapping="Wrap" />
        </Grid>
        <CheckBox Name="HostKeyRemember" Content="{l:Tr hostKey.remember}" IsChecked="True" />
        <CheckBox Name="HostKeyVerified" Content="{l:Tr hostKey.verifiedChanged}" IsVisible="False" />
      </StackPanel>
    </carbon:Modal>

    <!-- MCP / AI tool approval (design §6.1, §6.3): queued, auto-denied at the deadline -->
    <carbon:Modal Name="ApprovalModal" Size="Medium">
      <StackPanel Spacing="16">
        <carbon:InlineNotification Name="ApprovalRisk" Kind="Warning" IsCloseButtonVisible="False" IsVisible="False" />
        <TextBlock Name="ApprovalBody" Classes="body-01" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="Auto,16,*" RowDefinitions="Auto,8,Auto,8,Auto">
          <TextBlock Classes="label-01 secondary" Text="{l:Tr approval.client}" />
          <TextBlock Grid.Column="2" Name="ApprovalClient" Classes="body-01" />
          <TextBlock Grid.Row="2" Classes="label-01 secondary" Text="{l:Tr approval.tool}" />
          <TextBlock Grid.Row="2" Grid.Column="2" Name="ApprovalTool" Classes="body-01" />
          <TextBlock Grid.Row="4" Classes="label-01 secondary" Text="{l:Tr approval.host}" />
          <TextBlock Grid.Row="4" Grid.Column="2" Name="ApprovalHost" Classes="body-01" />
        </Grid>
        <Border Background="{DynamicResource CarbonField02}" BorderBrush="{DynamicResource CarbonBorderSubtle02}" BorderThickness="0,0,0,1" Padding="16,12">
          <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Auto">
            <SelectableTextBlock Name="ApprovalSummary" Classes="code-01" TextWrapping="Wrap" />
          </ScrollViewer>
        </Border>
        <TextBlock Name="ApprovalReasonText" Classes="helper-text-01 secondary" TextWrapping="Wrap" />
        <TextBlock Name="ApprovalCountdown" Classes="helper-text-01 secondary" />
      </StackPanel>
    </carbon:Modal>

    <!-- passphrase for an encrypted key saved without it -->
    <carbon:Modal Name="PassphraseModal" Size="Small">
      <StackPanel Spacing="16">
        <TextBlock Name="PassphraseBody" Classes="body-01" TextWrapping="Wrap" />
        <TextBox Name="PassphraseBox" Classes="password" PasswordChar="●" />
      </StackPanel>
    </carbon:Modal>

    <!-- Legacy (Tauri) data import offer (design §5.4) -->
    <carbon:Modal Name="LegacyModal" Size="Small"
                  Heading="{l:Tr legacy.found.title}"
                  PrimaryButtonText="{l:Tr legacy.import}" SecondaryButtonText="{l:Tr legacy.later}">
      <TextBlock Classes="body-01" TextWrapping="Wrap" Text="{Binding LegacyOfferText}" />
    </carbon:Modal>
  </Panel>
</Window>
